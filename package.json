{
  "name": "infercloud-pi",
  "version": "0.1.0-rc.2",
  "private": true,
  "description": "InferCloud provider integration for the Pi coding agent",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "infercloud"
  ],
  "files": [
    "src/",
    "docs/",
    "examples/",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "smoke:live": "node --import tsx scripts/compatibility-smoke.ts",
    "usage:reconcile": "node --import tsx scripts/reconcile-usage.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brassinai/inferops-pi.git"
  },
  "bugs": {
    "url": "https://github.com/Brassinai/inferops-pi/issues"
  },
  "homepage": "https://github.com/Brassinai/inferops-pi#readme"
}
