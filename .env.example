# Optional automation credentials; Pi /login stores native credentials in auth.json.
# .env is not loaded automatically. Supply real keys through a secret manager.
INFERCLOUD_API_KEY=
# Optional when models.json does not configure a provider baseUrl.
INFERCLOUD_BASE_URL=https://api.infercloud.ai/v1

# Live compatibility checks require explicit opt-in and verified model limits.
INFERCLOUD_PI_LIVE_TEST=0
INFERCLOUD_PI_USE_EXTENSION=1
INFERCLOUD_PI_MODEL=
INFERCLOUD_PI_CONTEXT_WINDOW=
INFERCLOUD_PI_MAX_OUTPUT_TOKENS=
